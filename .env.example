# Copy to .env. AWS credentials come from the normal AWS credential chain
# (aws configure / SSO / env vars). Never put keys in this file.

PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 only on a trusted network and set ADMIN_TOKEN.
HOST=127.0.0.1

BEDROCK_REGION=us-east-1
# Default works on the event account without extra setup.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Claude needs the one-time "Anthropic use case details" form in the Bedrock console first.
# Then try: us.anthropic.claude-haiku-4-5-20251001-v1:0 (fast) or us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional fallback model. Off by default, because a model switch changes behavior. If set, every switch is logged and alerted.
BEDROCK_FALLBACK_MODEL_ID=

# If set, the coordinator console and /api/admin/* require this token.
ADMIN_TOKEN=

# Caller records (sessions, holds, dispatches, log) expire after this many ms. Default 24h.
RECORD_TTL_MS=86400000

# Set to 1 to expose POST /api/_test/tool (used by the surge test). Leave off otherwise.
ENABLE_TEST_API=0
